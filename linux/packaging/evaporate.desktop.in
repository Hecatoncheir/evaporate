# Заготовка: @EXEC@ и @ICON@ подставляет тот, кто ставит. Пакет .deb знает
# свои пути заранее, самораспаковывающийся .run — только в момент установки,
# и держать ради этого две почти одинаковые записи значит однажды поправить
# одну.
[Desktop Entry]
Type=Application
Name=Evaporate
Comment=Game launcher: library, BitTorrent downloads and portable saves
Comment[ru]=Лончер игр: библиотека, загрузки по BitTorrent и переносимые сохранения
Exec="@EXEC@" %U
Icon=@ICON@
Terminal=false
Categories=Game;
# Путь в кавычках: домашняя папка может оказаться с пробелом, а Exec
# разбирается по словам — без них система запустила бы половину пути.
# Окно, которое создаёт сборка Flutter, зовётся именем бинарника. Без этой
# строки оболочка не свяжет окно с ярлыком: в панели задач появится вторая
# запись с безымянным значком.
StartupWMClass=evaporate
