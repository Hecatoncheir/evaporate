[Desktop Entry]
Type=Application
Name=Evaporate
Comment=Game launcher: library, BitTorrent downloads and portable saves
Comment[ru]=Лончер игр: библиотека, загрузки по BitTorrent и переносимые сохранения
Exec=/opt/evaporate/evaporate %U
Icon=evaporate
Terminal=false
Categories=Game;
# Окно, которое создаёт сборка Flutter, зовётся именем бинарника. Без этой
# строки оболочка не свяжет окно с ярлыком: в панели задач появится вторая
# запись с безымянным значком.
StartupWMClass=evaporate
